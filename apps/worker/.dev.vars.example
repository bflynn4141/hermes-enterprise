# Copy to apps/worker/.dev.vars (gitignored) before `wrangler dev`.
# Every secret the product uses is named here; none of them has a real value in
# the repository, and CI runs gitleaks to keep it that way.

# --- Local Postgres through Hyperdrive ---------------------------------------
# Wrangler reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_<BINDING> in
# local development and ignores the remote Hyperdrive config. Two strings,
# because two database roles with different grants.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_APP="postgres://app:localdev@127.0.0.1:5433/hermes"
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_AGENT="postgres://agent:localdev@127.0.0.1:5433/hermes"

# --- WorkOS AuthKit (M2) ------------------------------------------------------
# WORKOS_COOKIE_PASSWORD must be at least 32 characters. Rotating it signs
# everyone out, so it happens off-hours.
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""
WORKOS_COOKIE_PASSWORD=""
# Exact `issuer` from this application's OIDC discovery document. Required by
# staging and production readiness; do not infer it from another application.
WORKOS_ISSUER=""
# Explicit in staging and production. Whatever it resolves to must be
# registered as a redirect URI in the WorkOS dashboard, exactly.
WORKOS_REDIRECT_URI=""

# --- TypeSafe Jev Inbox classifier ------------------------------------------
# Needed only when INBOX_TRIAGE_MODE is shadow or active.
TYPESAFE_API_KEY=""

# --- Slack workspace channel -------------------------------------------------
# Create one granular-permissions Slack app from docs/slack-app-manifest.yaml.
# The redirect URI and Events API Request URL must exactly match the public
# Worker origin. Leave disabled to render the truthful unconfigured state.
SLACK_ENABLED="0"
GMAIL_OUTREACH_ENABLED="0"
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# GMAIL_STATE_SECRET=""
# GMAIL_REDIRECT_URI="http://localhost:8787/integrations/gmail/oauth/callback"

# Optional selected-thread evidence intake. Use a separate Google OAuth client;
# never reuse the outreach sender client or its secret.
GMAIL_EVIDENCE_ENABLED="0"
# GMAIL_EVIDENCE_CLIENT_ID="...apps.googleusercontent.com"
# GMAIL_EVIDENCE_CLIENT_SECRET="..."
# GMAIL_EVIDENCE_STATE_SECRET="replace-with-at-least-32-random-characters"
# GMAIL_EVIDENCE_REDIRECT_URI="http://localhost:8787/integrations/gmail-evidence/oauth/callback"
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""
# Independent HMAC secret for expiring OAuth state. Generate at least 32 random bytes.
SLACK_STATE_SECRET=""
SLACK_REDIRECT_URI="http://localhost:8787/integrations/slack/oauth/callback"

# Signs the hub tickets a WebSocket presents to extend its authorisation.
# Falls back to WORKOS_COOKIE_PASSWORD; in development only, to a constant.
# A deployed environment with neither refuses to mint a ticket rather than
# signing one with a guessable key.
HUB_TICKET_SECRET=""

# --- Bring your own key (M2) --------------------------------------------------
# The key-encryption key. Base64, 32 bytes. A rotation adds KEK_V2 and keeps
# KEK_V1 until every backup that could hold DEKs wrapped under it has expired.
KEK_V1=""
# Which version new keys are encrypted under. Empty means the highest KEK_V{n}
# present. A rotation sets this to the new number in a second deploy, after the
# secret itself has landed everywhere.
KEK_CURRENT=""

# --- Nous Portal OAuth -------------------------------------------------------
# Official Hermes Agent uses the public `hermes-cli` client for device-code
# inference grants. That client is appropriate for local/staging proof. Use a
# separately attributable Nous client for production when one is provisioned.
# When either value is absent, the UI says hosted sign-in is unavailable and
# offers the existing manual workspace-key fallback. Do not use the dashboard
# `agent:{id}` client: that token has agent_dashboard:access, not inference:invoke.
NOUS_PORTAL_OAUTH_ENABLED="0"
NOUS_PORTAL_OAUTH_CLIENT_ID="hermes-cli"
# Production is pinned to https://portal.nousresearch.com. Override only for a
# local integration fixture.
NOUS_PORTAL_BASE_URL=""

# --- Partner screening public-source connector ------------------------------
# This policy is non-secret, but lives here locally because it is per agent.
# Production may set it as a plain Worker var. Queries discover organizations
# through GitHub's official REST API; the connector never reads public email,
# discovers individual people, or contacts anyone.
PARTNER_SCREENING_CONFIG_JSON='{"AGENT_UUID":{"source_purpose":"organization_partner_research","organization_only":true,"no_outreach":true,"role_label":"Potential technical ecosystem partner","search_queries":["developer education in:name,description,readme archived:false"],"intake_urls":[],"keywords":["developer education","agents","open source"],"ranking_weights":{"relevance":40,"activity":25,"adoption":20,"openness":15},"minimum_priority":50,"lookback_days":365,"max_candidates":5,"max_api_requests":12,"minimum_rate_remaining":5}}'
# Optional fallback for newly-created agents. Development and staging use this
# bounded policy so onboarding performs one real paid search before Iris screens.
PARTNER_SCREENING_DEFAULT_CONFIG_JSON='{"source":"agentcash_people","source_purpose":"person_partner_research","organization_only":false,"no_outreach":true,"role_label":"Potential ecosystem lead","search_queries":[],"intake_urls":[],"keywords":["artificial intelligence","developer relations"],"people_search":{"current_position_seniority_level":["Founder","Head","Director"],"person_skills":["Artificial Intelligence (AI)","Developer Relations"],"current_position_titles":[],"person_locations":[]},"ranking_weights":{"relevance":40,"activity":25,"adoption":20,"openness":15},"minimum_priority":40,"lookback_days":365,"max_candidates":5,"max_api_requests":1,"minimum_rate_remaining":0,"max_spend_usd":0.15}'
# Cloudflare Cron enqueues a durable discovery + Iris handoff once per cadence bucket.
AUTOMATED_TRIGGERS_ENABLED=1
PARTNER_SCREENING_AUTOMATE_DEFAULT_AGENTS=1
PARTNER_SCREENING_AUTOMATION_INTERVAL_MINUTES=360
# Optional. Public-only requests work without it at GitHub's lower IP-based
# limits. Use a fine-grained token with no repository permissions when set.
PARTNER_GITHUB_TOKEN=""
# Reserved connector credentials. Their presence does not enable a connector
# in this build; the source-readiness endpoint reports that truthfully.
PARTNER_YOUTUBE_API_KEY=""
PARTNER_X_BEARER_TOKEN=""

# --- R2 uploads (M3.5) --------------------------------------------------------
# The bucket itself is a binding (wrangler.jsonc, UPLOADS) and needs no secret.
# These three exist only so the Worker can sign a presigned PUT, so that 20 MB
# of bytes go from the browser to R2 and never through a Worker request.
#
# Create an R2 API token scoped to the uploads bucket with Object Read & Write.
# R2_ACCOUNT_ID is the Cloudflare account id; the S3 endpoint is derived from it
# as https://<account>.r2.cloudflarestorage.com.
#
# Leave all three empty for `wrangler dev --local`: with no credentials the
# attachments route answers a dev-only direct-upload URL on this Worker instead
# (`upload.direct: true`), which is refused outside development.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- Observability ------------------------------------------------------------
SENTRY_DSN=""
# Server-only Raindrop write key. Keep RAINDROP_OBSERVABILITY_MODE=off locally
# unless testing the exporter against a dedicated development project.
RAINDROP_WRITE_KEY=""
# Optional when the write key is already scoped to the intended project.
RAINDROP_PROJECT_ID=""

# --- Switches (also set as plain vars per environment in wrangler.jsonc) -------
# fake: `x-dev-user` names a seeded user. workos: sealed cookie (M2).
AUTH_MODE="fake"
# off | passthrough. Whether model calls go through an AI Gateway.
MODEL_GATEWAY_MODE="off"
# 1 refuses to create new Workflow instances; part of the engine-version runbook.
ENGINE_PAUSED="0"
# off | active. Staging is active in wrangler.jsonc but remains a no-op until
# RAINDROP_WRITE_KEY is configured as a Worker secret.
RAINDROP_OBSERVABILITY_MODE="off"

# Official Hermes runtime. Fixed profiles and permanently pre-bound invitation
# slots live in the deployment map. The application never creates, mutates or
# restarts a Cloud instance while a member accepts an invitation.
# AGENT_RUNTIME="hermes"
# HERMES_RUNTIME_AGENTS='{"POOL_AGENT_UUID":{"workspace_id":"WORKSPACE_UUID","base_url":"https://iris-pool.example/api/plugins/enterprise_bridge/control","api_key":"","transport":"dashboard_connector","assignment":"invitee_pool","agentcash":true}}'
HERMES_BRIDGE_SECRET=""
HERMES_POOL_LOW_CAPACITY_THRESHOLD="1"
HERMES_ENTERPRISE_PUBLIC_URL="https://staging.example.com"
# Exact values produced and reviewed with the installed enterprise_bridge build.
HERMES_ENTERPRISE_PLUGIN_REVISION=""
HERMES_ENTERPRISE_PLUGIN_SHA256=""

# The public request-access page (`/demo`). The passcode is the one secret; the
# other two are plain vars in wrangler.jsonc for staging and may be overridden
# here for a local run. Empty means the route answers
# `demo_access_not_configured` and invites nobody.
DEMO_ACCESS_PASSCODE=""
DEMO_ACCESS_WORKSPACE_ID=
DEMO_ACCESS_ALLOWED_DOMAINS=
