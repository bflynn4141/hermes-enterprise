# Copy to apps/worker/.dev.vars (gitignored) before `wrangler dev`.
# Every secret the product uses is named here; none of them has a real value in
# the repository, and CI runs gitleaks to keep it that way.

# --- Local Postgres through Hyperdrive ---------------------------------------
# Wrangler reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_<BINDING> in
# local development and ignores the remote Hyperdrive config. Two strings,
# because two database roles with different grants.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_APP="postgres://app:localdev@127.0.0.1:5433/hermes"
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_AGENT="postgres://agent:localdev@127.0.0.1:5433/hermes"

# --- WorkOS AuthKit (M2) ------------------------------------------------------
# WORKOS_COOKIE_PASSWORD must be at least 32 characters. Rotating it signs
# everyone out, so it happens off-hours.
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""
WORKOS_COOKIE_PASSWORD=""
# Exact `issuer` from this application's OIDC discovery document. Required by
# staging and production readiness; do not infer it from another application.
WORKOS_ISSUER=""
# Explicit in staging and production. Whatever it resolves to must be
# registered as a redirect URI in the WorkOS dashboard, exactly.
WORKOS_REDIRECT_URI=""

# Signs the hub tickets a WebSocket presents to extend its authorisation.
# Falls back to WORKOS_COOKIE_PASSWORD; in development only, to a constant.
# A deployed environment with neither refuses to mint a ticket rather than
# signing one with a guessable key.
HUB_TICKET_SECRET=""

# --- Bring your own key (M2) --------------------------------------------------
# The key-encryption key. Base64, 32 bytes. A rotation adds KEK_V2 and keeps
# KEK_V1 until every backup that could hold DEKs wrapped under it has expired.
KEK_V1=""
# Which version new keys are encrypted under. Empty means the highest KEK_V{n}
# present. A rotation sets this to the new number in a second deploy, after the
# secret itself has landed everywhere.
KEK_CURRENT=""

# --- R2 uploads (M3.5) --------------------------------------------------------
# The bucket itself is a binding (wrangler.jsonc, UPLOADS) and needs no secret.
# These three exist only so the Worker can sign a presigned PUT, so that 20 MB
# of bytes go from the browser to R2 and never through a Worker request.
#
# Create an R2 API token scoped to the uploads bucket with Object Read & Write.
# R2_ACCOUNT_ID is the Cloudflare account id; the S3 endpoint is derived from it
# as https://<account>.r2.cloudflarestorage.com.
#
# Leave all three empty for `wrangler dev --local`: with no credentials the
# attachments route answers a dev-only direct-upload URL on this Worker instead
# (`upload.direct: true`), which is refused outside development.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- Observability ------------------------------------------------------------
SENTRY_DSN=""

# --- Switches (also set as plain vars per environment in wrangler.jsonc) -------
# fake: `x-dev-user` names a seeded user. workos: sealed cookie (M2).
AUTH_MODE="fake"
# off | passthrough. Whether model calls go through an AI Gateway.
MODEL_GATEWAY_MODE="off"
# 1 refuses to create new Workflow instances; part of the engine-version runbook.
ENGINE_PAUSED="0"

# Official Hermes runtime. Map each agent to its own running profile.
# AGENT_RUNTIME="hermes"
# HERMES_RUNTIME_AGENTS='{"AGENT_UUID":{"workspace_id":"WORKSPACE_UUID","base_url":"http://127.0.0.1:8642","api_key":""}}'
HERMES_BRIDGE_SECRET=""
