{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-enterprise",
  "main": "src/index.ts",
  // Pinned to the newest date the workerd binary bundled with
  // @cloudflare/vitest-pool-workers supports. A later date makes the Worker
  // undeployable in tests, and a Worker we cannot run in workerd is a Worker we
  // cannot test in workerd. Raise both together.
  "compatibility_date": "2026-08-22",
  // `nodejs_compat` is what lets node-postgres run in the Worker; Hyperdrive's
  // own documentation assumes it.
  "compatibility_flags": ["nodejs_compat"],

  // A runaway tool loop should cost a request, not a bill. 30 s is the paid
  // ceiling; the alarm at 50 percent of the subrequest budget catches the other
  // runaway, which is chattiness rather than compute.
  "limits": { "cpu_ms": 30000 },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // The client bundle. `run_worker_first` on the API prefixes means a route
  // collision never serves index.html to a fetch(), and `single-page-application`
  // means a deep link like /w/:id/inbox still boots the app.
  //
  // Every prefix the Worker owns has to be in this list, including the two that
  // are not under a prefix at all: `POST /workspaces` and
  // `POST /invitations/:token/accept` were answered by the assets binding with
  // 405 before they were added, so the create-workspace and accept-invitation
  // routes were unreachable rather than broken. `/shared/*` is here so a share
  // link reaches the Worker's own catch-all, which answers a navigation with
  // the app and a fetch with JSON. See decision F1.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/internal/*", "/integrations/*", "/api/*", "/w/*", "/auth/*", "/workspaces", "/invitations/*", "/shared/*"]
  },

  "vars": {
    "ENVIRONMENT": "development",
    "ENGINE_VERSION": "1",
    "AUTH_MODE": "fake",
    "MODEL_GATEWAY_MODE": "off",
    "ENGINE_PAUSED": "0",
    // Development only: the engine answers from ScriptedProvider, so a run can
    // be created with no provider key in the store. A unit test asserts the
    // deployed environments never set it.
    "MODEL_SCRIPTED": "1",
    // Development only, and the same rule: the provider verification and model-list endpoints
    // answer from a built-in fixture rather than the network, so the live
    // scenario can verify a key and sync a catalog with no key and no egress.
    // A unit test asserts the deployed environments never set it.
    "OPENROUTER_FIXTURE": "1",
    "NOUS_PORTAL_FIXTURE": "1",
    "SLACK_ENABLED": "0",
    "ALLOWED_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787",
    // The only provider this product offers (decision C55). Read by
    // `model/allowed.ts`; a key, a catalog row, a session model or a run naming
    // anything else is refused with `provider_not_allowed`. A unit test asserts
    // this value in all three environments, because an environment that lost it
    // would be the one place the other adapters became reachable.
    "ALLOWED_PROVIDERS": "nous_portal",
    // The platform cap on Workflow creations per hour, across every tenant.
    // Empty means no cap, which is what local development wants.
    "PLATFORM_MAX_INSTANCES_PER_HOUR": "",
    // Demo/dev only: the existing minute Cron admits configured partner-source
    // jobs in six-hour idempotency buckets. No config means no work is queued.
    "AUTOMATED_TRIGGERS_ENABLED": "1",
    "PARTNER_SCREENING_AUTOMATE_DEFAULT_AGENTS": "1",
    "PARTNER_SCREENING_AUTOMATION_INTERVAL_MINUTES": "360",
    "PARTNER_SCREENING_PAID_AUTOMATION_ENABLED": "0",
    // Bounded live onboarding search. Iris makes one paid AgentCash People
    // Search call, capped at $0.15, and the Worker strips contact data.
    "PARTNER_SCREENING_DEFAULT_CONFIG_JSON": "{\"source\":\"agentcash_people\",\"source_purpose\":\"person_partner_research\",\"organization_only\":false,\"no_outreach\":true,\"role_label\":\"Potential ecosystem lead\",\"search_queries\":[],\"intake_urls\":[],\"keywords\":[\"artificial intelligence\",\"developer relations\"],\"people_search\":{\"current_position_seniority_level\":[\"Founder\",\"Head\",\"Director\"],\"person_skills\":[\"Artificial Intelligence (AI)\",\"Developer Relations\"],\"current_position_titles\":[],\"person_locations\":[]},\"ranking_weights\":{\"relevance\":40,\"activity\":25,\"adoption\":20,\"openness\":15},\"minimum_priority\":40,\"lookback_days\":365,\"max_candidates\":5,\"max_api_requests\":1,\"minimum_rate_remaining\":0,\"max_spend_usd\":0.15}",
    "HERMES_CLOUD_AUTOPROVISION_ENABLED": "0",
    "HERMES_CLOUD_REGION": "sjc",
    "HERMES_CLOUD_MODEL": "z-ai/glm-5.2",
    "HERMES_CLOUD_SIZE": "medium",
    "HERMES_CLOUD_MAX_AGENTS_PER_WORKSPACE": "5",
    "HERMES_CLOUD_MAX_AGENTS": "10",
    "HERMES_ENTERPRISE_PUBLIC_URL": "https://localhost.invalid",
    "R2_BUCKET": "hermes-uploads"
  },

  // Uploads, the `.txt` next to each one, and from M4 the rendered documents.
  // The binding is how the Worker reads and writes; the presigned PUT the
  // browser uses is signed with the S3 credentials in .dev.vars, and needs the
  // bucket *name* above because a URL cannot resolve a binding. `wrangler dev
  // --local` simulates this bucket on disk, with no account and no credentials,
  // which is why the attachments route has a direct-upload fallback.
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "hermes-uploads" }
  ],

  // Durable Object classes are declared in `exports`, which the docs allow at
  // the top level and overridden per environment. A rename is a `renamed`
  // tombstone in that map, never an edit to the class name: removing a name
  // deletes its namespace and all of its stored data permanently. Both hubs
  // hold no truth, so that would cost one reconnect rather than data, but the
  // rule stands. Gradual deployments are not supported with `exports`.
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_HUB", "class_name": "SessionHub" },
      { "name": "WORKSPACE_HUB", "class_name": "WorkspaceHub" }
    ]
  },
  // `exports` is the declarative form and is mutually exclusive with
  // `migrations`. Both hubs are SQLite-backed Durable Objects.
  "exports": {
    "SessionHub": { "type": "durable-object", "storage": "sqlite" },
    "WorkspaceHub": { "type": "durable-object", "storage": "sqlite" }
  },

  // One instance per run attempt, id `${run_id}-a${attempt}`. The other three
  // are the long waits (M5a): a workspace deletion sleeps seven days, a KEK
  // rotation takes one step per workspace, and the nightly validator takes one
  // step per 200 runs because a Cron handler caps at 15 minutes.
  "workflows": [
    {
      "name": "hermes-run-attempt",
      "binding": "RUN_ATTEMPT",
      "class_name": "RunAttempt"
    },
    { "name": "hermes-workspace-deletion", "binding": "WORKSPACE_DELETION", "class_name": "WorkspaceDeletion" },
    { "name": "hermes-kek-rotation", "binding": "KEK_ROTATION", "class_name": "KekRotation" },
    { "name": "hermes-nightly-validator", "binding": "NIGHTLY_VALIDATOR", "class_name": "NightlyValidator" }
  ],

  // The platform metrics dataset (plan section 5): run duration, tool error
  // rate, provider p95, socket reconnects, Stop latency, subrequests per
  // instance, daily spend. Bound in every environment so the code path is the
  // same everywhere; `wrangler dev --local` simulates it.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "hermes_metrics" }
  ],

  // Both queues carry a dead-letter queue. Without one, a message that exhausts
  // its retries is deleted, and the row it was about keeps saying "preparing"
  // forever. The DLQ consumer writes `failed` plus a reason instead.
  "queues": {
    "producers": [
      { "binding": "EXTRACT_QUEUE", "queue": "hermes-extract" },
      { "binding": "RENDERS_QUEUE", "queue": "hermes-renders" }
    ],
    "consumers": [
      {
        "queue": "hermes-extract",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "hermes-extract-dlq"
      },
      {
        "queue": "hermes-renders",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "hermes-renders-dlq"
      },
      { "queue": "hermes-extract-dlq", "max_batch_size": 5, "max_retries": 1 },
      { "queue": "hermes-renders-dlq", "max_batch_size": 5, "max_retries": 1 }
    ]
  },

  // Every minute: drain jobs, sweep orphaned runs, poll the WorkOS Events API.
  // Nightly at 03:17 UTC: the run-log validator Workflow.
  "triggers": {
    "crons": ["* * * * *", "17 3 * * *"]
  },

  // Two configs because two database roles. Caching is disabled on both:
  // Hyperdrive caches by query text and does not document whether session
  // settings enter the key, and a cache that ignored `SET LOCAL app.workspace_id`
  // would hand one tenant another tenant's rows.
  "hyperdrive": [
    // Local development points these at Docker Postgres through
    // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_APP and
    // ..._HYPERDRIVE_AGENT in .dev.vars, so no credential lives in this file.
    { "binding": "HYPERDRIVE_APP", "id": "0000000000000000000000000000app0" },
    { "binding": "HYPERDRIVE_AGENT", "id": "0000000000000000000000000agent00" }
  ],

  "env": {
    "staging": {
      "name": "hermes-enterprise-staging",
      "limits": { "cpu_ms": 30000 },
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "assets": {
        "directory": "../client/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/health", "/internal/*", "/api/*", "/w/*", "/auth/*", "/workspaces", "/invitations/*", "/shared/*"]
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "ENGINE_VERSION": "1",
        "AUTH_MODE": "workos",
        "MODEL_GATEWAY_MODE": "off",
        "ENGINE_PAUSED": "0",
        // Production-demo invariant: an invitation is deliverable only after a
        // verified warm-pool Iris has been reserved for it.
        "AGENT_RUNTIME": "hermes",
        "ALLOWED_ORIGINS": "https://staging.hermes.brianflynn.dev",
        "WORKOS_REDIRECT_URI": "https://staging.hermes.brianflynn.dev/auth/callback",
        "NOUS_PORTAL_OAUTH_ENABLED": "1",
        // Official Hermes Agent's public device-code client. It is suitable for
        // staging proof; production should use a separately attributable client.
        "NOUS_PORTAL_OAUTH_CLIENT_ID": "hermes-cli",
        "ALLOWED_PROVIDERS": "nous_portal",
        "PLATFORM_MAX_INSTANCES_PER_HOUR": "500",
        "AUTOMATED_TRIGGERS_ENABLED": "1",
        "PARTNER_SCREENING_AUTOMATE_DEFAULT_AGENTS": "1",
        "PARTNER_SCREENING_AUTOMATION_INTERVAL_MINUTES": "360",
        "PARTNER_SCREENING_PAID_AUTOMATION_ENABLED": "0",
        "PARTNER_SCREENING_DEFAULT_CONFIG_JSON": "{\"source\":\"agentcash_people\",\"source_purpose\":\"person_partner_research\",\"organization_only\":false,\"no_outreach\":true,\"role_label\":\"Potential ecosystem lead\",\"search_queries\":[],\"intake_urls\":[],\"keywords\":[\"artificial intelligence\",\"developer relations\"],\"people_search\":{\"current_position_seniority_level\":[\"Founder\",\"Head\",\"Director\"],\"person_skills\":[\"Artificial Intelligence (AI)\",\"Developer Relations\"],\"current_position_titles\":[],\"person_locations\":[]},\"ranking_weights\":{\"relevance\":40,\"activity\":25,\"adoption\":20,\"openness\":15},\"minimum_priority\":40,\"lookback_days\":365,\"max_candidates\":5,\"max_api_requests\":1,\"minimum_rate_remaining\":0,\"max_spend_usd\":0.15}",
        "HERMES_CLOUD_AUTOPROVISION_ENABLED": "0",
        "HERMES_CLOUD_REGION": "sjc",
        "HERMES_CLOUD_MODEL": "z-ai/glm-5.2",
        "HERMES_CLOUD_SIZE": "medium",
        "HERMES_CLOUD_MAX_AGENTS_PER_WORKSPACE": "5",
        "HERMES_CLOUD_MAX_AGENTS": "10",
        "HERMES_POOL_LOW_CAPACITY_THRESHOLD": "1",
        "HERMES_ENTERPRISE_PUBLIC_URL": "https://staging.hermes.brianflynn.dev",
        "R2_BUCKET": "hermes-uploads-staging"
      },
      // The backup bucket is bound only where it exists; `backup_uploads` logs
      // that it did nothing when the binding is absent rather than failing.
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "hermes-uploads-staging" },
        { "binding": "BACKUP_UPLOADS", "bucket_name": "hermes-uploads-backup-staging" }
      ],
      // CI asserts that staging and production declare the same classes: a
      // mismatch is a namespace that exists in one environment and not the
      // other, which is discovered at the worst possible moment.
      "durable_objects": {
        "bindings": [
          { "name": "SESSION_HUB", "class_name": "SessionHub" },
          { "name": "WORKSPACE_HUB", "class_name": "WorkspaceHub" }
        ]
      },
      "exports": {
        "SessionHub": { "type": "durable-object", "storage": "sqlite" },
        "WorkspaceHub": { "type": "durable-object", "storage": "sqlite" }
      },
      "workflows": [
        { "name": "hermes-run-attempt-staging", "binding": "RUN_ATTEMPT", "class_name": "RunAttempt" },
        { "name": "hermes-workspace-deletion-staging", "binding": "WORKSPACE_DELETION", "class_name": "WorkspaceDeletion" },
        { "name": "hermes-kek-rotation-staging", "binding": "KEK_ROTATION", "class_name": "KekRotation" },
        { "name": "hermes-nightly-validator-staging", "binding": "NIGHTLY_VALIDATOR", "class_name": "NightlyValidator" }
      ],
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS", "dataset": "hermes_metrics_staging" }
      ],
      "queues": {
        "producers": [
          { "binding": "EXTRACT_QUEUE", "queue": "hermes-extract-staging" },
          { "binding": "RENDERS_QUEUE", "queue": "hermes-renders-staging" }
        ],
        "consumers": [
          {
            "queue": "hermes-extract-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "hermes-extract-staging-dlq"
          },
          {
            "queue": "hermes-renders-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "hermes-renders-staging-dlq"
          },
          { "queue": "hermes-extract-staging-dlq", "max_batch_size": 5, "max_retries": 1 },
          { "queue": "hermes-renders-staging-dlq", "max_batch_size": 5, "max_retries": 1 }
        ]
      },
      "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
      "hyperdrive": [
        { "binding": "HYPERDRIVE_APP", "id": "0de9d1d5611a49cc826a529f82d44e4f" },
        { "binding": "HYPERDRIVE_AGENT", "id": "c64a6075522a4c568c4d6db1789aa6e2" }
      ]
    },

    "production": {
      "name": "hermes-enterprise-production",
      "limits": { "cpu_ms": 30000 },
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "assets": {
        "directory": "../client/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/health", "/internal/*", "/api/*", "/w/*", "/auth/*", "/workspaces", "/invitations/*", "/shared/*"]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "ENGINE_VERSION": "1",
        "AUTH_MODE": "workos",
        "MODEL_GATEWAY_MODE": "off",
        "ENGINE_PAUSED": "0",
        // Keep the production invitation path fail-closed: no verified,
        // reserved Iris means no invitation is sent.
        "AGENT_RUNTIME": "hermes",
        "ALLOWED_ORIGINS": "https://app.hermes.brianflynn.dev",
        "WORKOS_REDIRECT_URI": "https://app.hermes.brianflynn.dev/auth/callback",
        "NOUS_PORTAL_OAUTH_ENABLED": "1",
        "ALLOWED_PROVIDERS": "nous_portal",
        "PLATFORM_MAX_INSTANCES_PER_HOUR": "2000",
        "AUTOMATED_TRIGGERS_ENABLED": "0",
        "PARTNER_SCREENING_AUTOMATE_DEFAULT_AGENTS": "0",
        "PARTNER_SCREENING_AUTOMATION_INTERVAL_MINUTES": "360",
        "PARTNER_SCREENING_PAID_AUTOMATION_ENABLED": "0",
        // Available only through the member-owned approval created at
        // acceptance. Background automation remains disabled above.
        "PARTNER_SCREENING_DEFAULT_CONFIG_JSON": "{\"source\":\"agentcash_people\",\"source_purpose\":\"person_partner_research\",\"organization_only\":false,\"no_outreach\":true,\"role_label\":\"Potential ecosystem lead\",\"search_queries\":[],\"intake_urls\":[],\"keywords\":[\"artificial intelligence\",\"developer relations\"],\"people_search\":{\"current_position_seniority_level\":[\"Founder\",\"Head\",\"Director\"],\"person_skills\":[\"Artificial Intelligence (AI)\",\"Developer Relations\"],\"current_position_titles\":[],\"person_locations\":[]},\"ranking_weights\":{\"relevance\":40,\"activity\":25,\"adoption\":20,\"openness\":15},\"minimum_priority\":40,\"lookback_days\":365,\"max_candidates\":5,\"max_api_requests\":1,\"minimum_rate_remaining\":0,\"max_spend_usd\":0.15}",
        "HERMES_CLOUD_AUTOPROVISION_ENABLED": "0",
        "HERMES_CLOUD_REGION": "sjc",
        "HERMES_CLOUD_MODEL": "z-ai/glm-5.2",
        "HERMES_CLOUD_SIZE": "medium",
        "HERMES_CLOUD_MAX_AGENTS_PER_WORKSPACE": "5",
        "HERMES_CLOUD_MAX_AGENTS": "10",
        "HERMES_POOL_LOW_CAPACITY_THRESHOLD": "1",
        "HERMES_ENTERPRISE_PUBLIC_URL": "https://app.hermes.brianflynn.dev",
        "R2_BUCKET": "hermes-uploads-production"
      },
      // The backup bucket is bound only where it exists; `backup_uploads` logs
      // that it did nothing when the binding is absent rather than failing.
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "hermes-uploads-production" },
        { "binding": "BACKUP_UPLOADS", "bucket_name": "hermes-uploads-backup-production" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "SESSION_HUB", "class_name": "SessionHub" },
          { "name": "WORKSPACE_HUB", "class_name": "WorkspaceHub" }
        ]
      },
      "exports": {
        "SessionHub": { "type": "durable-object", "storage": "sqlite" },
        "WorkspaceHub": { "type": "durable-object", "storage": "sqlite" }
      },
      "workflows": [
        { "name": "hermes-run-attempt-production", "binding": "RUN_ATTEMPT", "class_name": "RunAttempt" },
        { "name": "hermes-workspace-deletion-production", "binding": "WORKSPACE_DELETION", "class_name": "WorkspaceDeletion" },
        { "name": "hermes-kek-rotation-production", "binding": "KEK_ROTATION", "class_name": "KekRotation" },
        { "name": "hermes-nightly-validator-production", "binding": "NIGHTLY_VALIDATOR", "class_name": "NightlyValidator" }
      ],
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS", "dataset": "hermes_metrics_production" }
      ],
      "queues": {
        "producers": [
          { "binding": "EXTRACT_QUEUE", "queue": "hermes-extract-production" },
          { "binding": "RENDERS_QUEUE", "queue": "hermes-renders-production" }
        ],
        "consumers": [
          {
            "queue": "hermes-extract-production",
            "max_batch_size": 5,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "hermes-extract-production-dlq"
          },
          {
            "queue": "hermes-renders-production",
            "max_batch_size": 5,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "hermes-renders-production-dlq"
          },
          { "queue": "hermes-extract-production-dlq", "max_batch_size": 5, "max_retries": 1 },
          { "queue": "hermes-renders-production-dlq", "max_batch_size": 5, "max_retries": 1 }
        ]
      },
      "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
      "hyperdrive": [
        { "binding": "HYPERDRIVE_APP", "id": "ea9b34a1a62747db981170cc56783119" },
        { "binding": "HYPERDRIVE_AGENT", "id": "02a1409b651741b28fe13b9f262bd0b5" }
      ]
    }
  }
}
