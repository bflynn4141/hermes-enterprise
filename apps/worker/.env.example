# Copy to apps/worker/.env (gitignored).
#
# These two are read by wrangler itself while it parses wrangler.jsonc, not by
# the Worker, which is why they live here rather than in .dev.vars: wrangler
# needs them before the Worker exists. Everything else a deployment needs is in
# .dev.vars.example.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_APP="postgres://app:localdev@127.0.0.1:5433/hermes"
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_AGENT="postgres://agent:localdev@127.0.0.1:5433/hermes"
