ENTERPRISE_URL=https://your-enterprise-service.example
ENTERPRISE_WORKSPACE_ID=workspace-id
ENTERPRISE_AGENT_ID=00000000-0000-4000-8000-000000000000
# Provision through the enterprise service; never use its workspace provider key here.
ENTERPRISE_RUNTIME_TOKEN=replace-with-agent-scoped-runtime-token
API_SERVER_KEY=replace-with-a-random-native-api-secret

# Demo gates. Cloudflare remains the business-trigger scheduler; native cron is
# available for operator-created runtime chores and agent self-scheduling stays off.
HERMES_NATIVE_CRON_ENABLED=0
HERMES_AGENTCASH_MCP_ENABLED=0
# Use a dedicated directory containing .agentcash/wallet.json. Pointing this at
# a personal HOME gives third-party MCP code unnecessary filesystem authority.
AGENTCASH_HOME=/srv/hermes-agentcash

# Optional advanced MCP servers. Every server needs an explicit tool allowlist;
# env values may only be ${SCOPED_NAME} references supplied in this file. Do not
# put literal credentials in this JSON because non-secret config is persisted.
# ENTERPRISE_MCP_SERVERS_JSON='{"example":{"command":"/opt/example-mcp","args":[],"env":{"EXAMPLE_TOKEN":"${EXAMPLE_MCP_TOKEN}"},"tools":{"include":["lookup"]},"policy":{"allowed_hosts":[],"max_amount_usd":0}}}'
# EXAMPLE_MCP_TOKEN=replace-with-scoped-secret
